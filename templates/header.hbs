<div id="digify-brand-intro" class="digify-brand-intro" aria-hidden="true">
  <div class="digify-brand-intro__mark"><span>D</span></div>
  <span class="digify-brand-intro__name">Digify CX</span>
</div>
<script>
  (function () {
    var intro = document.getElementById("digify-brand-intro");
    var storageKey = "digify_intro_seen_v1";
    var reduceMotion = window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var seen = false;

    try {
      seen = window.sessionStorage.getItem(storageKey) === "1";
    } catch (error) {
      seen = false;
    }

    if (!intro || reduceMotion || seen) {
      if (intro) intro.remove();
      return;
    }

    try {
      window.sessionStorage.setItem(storageKey, "1");
    } catch (error) {
      // The intro remains non-blocking when storage is unavailable.
    }

    intro.classList.add("digify-brand-intro--visible");
    window.setTimeout(function () {
      intro.classList.add("digify-brand-intro--leaving");
    }, 260);
    window.setTimeout(function () {
      if (intro.parentNode) intro.parentNode.removeChild(intro);
    }, 400);
  })();
</script>

<header class="digify-header" data-digify-motion="reveal">
