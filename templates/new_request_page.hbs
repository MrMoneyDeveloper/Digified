<section class="dbpo-request digify-form-page">
  <div class="container digify-shell">
    <div class="row justify-content-center">
      <div class="col-12 col-xxl-10">
        <div class="form-header digify-form-hero">
          <h1>{{t 'submit_a_request'}}</h1>
          <p class="form-required-note">Fields marked with an asterisk (*) are required.</p>
        </div>
        <div class="digify-form-card">
          <div id="new-request-form"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module">
  import { renderNewRequestForm } from "new-request-form";

  const container = document.getElementById("new-request-form");
  const settings = {{json settings}};
  const showSuggestedArticles = settings.show_suggested_articles ?? true;
  const requestForm = {{json new_request_form}};

  // Zendesk's dedicated Subject renderer is currently discarding keyboard
  // input in this Help Center, while the standard text renderer remains stable.
  // Preserve the real request[subject] field and all of its validation, but send
  // only that field through the standard text input component.
  if (requestForm && Array.isArray(requestForm.ticket_fields)) {
    requestForm.ticket_fields = requestForm.ticket_fields.map((field) => {
      if (
        field &&
        field.type === "subject" &&
        field.name === "request[subject]"
      ) {
        return { ...field, type: "text" };
      }

      return field;
    });
  }

  const props = {
    requestForm,
    newRequestPath: {{json (page_path 'new_request')}},
    parentId: {{json parent.id}},
    parentIdPath: {{json parent.url}},
    locale: {{json help_center.locale}},
    baseLocale: {{json help_center.base_locale}},
    hasAtMentions: {{json help_center.at_mentions_enabled}},
    userRole: {{json user.role}},
    userId: {{json user.id}},
    brandId: {{json brand.id}},
    organizations: {{json user.organizations}},
    wysiwyg: true,
    showSuggestedArticles: showSuggestedArticles,
    answerBotModal: {
      answerBot: {{#if answer_bot}}{{json answer_bot}}{{else}}null{{/if}},
      answerBotGenerativeExperience: {{#if answer_bot_generative_experience}}{{json answer_bot_generative_experience}}{{else}}null{{/if}},
      hasRequestManagement: {{json help_center.request_management_enabled}},
      isSignedIn: {{json signed_in}},
      helpCenterPath: {{json (page_path 'help_center')}},
      requestsPath: {{json (page_path 'requests')}},
      requestPath: {{json (page_path 'request' id=request_id)}}
    },
  };

  renderNewRequestForm(settings, props, container);
</script>
